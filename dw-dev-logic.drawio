        <mxCell id="title" value="DW-DEV | DATA FLOW &amp; ORCHESTRATION" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#18212B;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subTitle" value="Source registration, scheduled/manual runs, validated landing files, staging load and downstream publishing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#52616B;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="user" value="Operator&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;GUI / REST&lt;br&gt;HTTP Basic Auth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="155" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="Scheduler&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;croniter; checks every 5 s&lt;br&gt;enabled sources only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="orchestrator" value="ORCHESTRATOR&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;FastAPI + runner&lt;br&gt;pre-flight dependency health&lt;br&gt;one active run per source&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF2;strokeColor=#277C87;strokeWidth=2;fontColor=#12343B;fontSize=17;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="190" width="240" height="145" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="Orchestrator SQLite&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;sources, cron / next_run&lt;br&gt;runs, step, status, error&lt;br&gt;filename, batch_id&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF1D6;strokeColor=#B27B19;strokeWidth=1.5;fontColor=#3A2C13;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="315" y="410" width="230" height="125" as="geometry" />
        </mxCell>

        <mxCell id="extractor" value="EXTRACTOR&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;allowlist URL check&lt;br&gt;GET source; validate JSON&lt;br&gt;write payload + manifest atomically&lt;br&gt;manifest includes SHA-256&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E5;strokeColor=#42865A;strokeWidth=2;fontColor=#183D25;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="190" width="250" height="145" as="geometry" />
        </mxCell>
        <mxCell id="source" value="External HTTP JSON source&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;host must be allowlisted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="55" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="landing" value="LANDING&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;shared host-mounted directory&lt;br&gt;raw JSON + matching .manifest.json&lt;br&gt;payload remains unchanged&lt;/font&gt;" style="shape=folder;tabWidth=40;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#E8E5F5;strokeColor=#7665A8;strokeWidth=1.5;fontColor=#2F2850;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="205" width="220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="loader" value="LOADER&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;check manifest + payload name&lt;br&gt;verify SHA-256; reject invalid files&lt;br&gt;flatten nested JSON&lt;br&gt;deduplicate filename / batch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE6D8;strokeColor=#BD7144;strokeWidth=2;fontColor=#4D2D1B;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="190" width="250" height="145" as="geometry" />
        </mxCell>
        <mxCell id="staging" value="STAGING (PostgreSQL)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;staging.raw_batches (raw payload)&lt;br&gt;dynamic source / child tables&lt;br&gt;row IDs, parent IDs, batch IDs&lt;br&gt;schema adapts to new columns&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FCE6D8;strokeColor=#BD7144;strokeWidth=2;fontColor=#4D2D1B;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1630" y="190" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="users" value="USERS (PostgreSQL)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;department + end_user&lt;br&gt;fixed reference data&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1645" y="420" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="core" value="CORE (PostgreSQL)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;sync_users() + sync_from_staging()&lt;br&gt;dynamic dim_* tables&lt;br&gt;SCD2: insert changed versions,&lt;br&gt;close changed / disappeared rows&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E3EDF8;strokeColor=#4D79A8;strokeWidth=2;fontColor=#1D3550;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1980" y="190" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="mart" value="MART (PostgreSQL)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;mart.refresh() rebuilds tables&lt;br&gt;current rows only; excludes SCD columns&lt;br&gt;GRANT SELECT to reporting&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F8E4EB;strokeColor=#A84C69;strokeWidth=2;fontColor=#4B2330;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2330" y="190" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="reporting" value="Reporting&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;read-only SELECT&lt;br&gt;mart.*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2670" y="215" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="runState" value="Run lifecycle&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;queued → health_check → extract → load → core → mart → done&lt;br&gt;Any failed step records status, step, error and finish time&lt;br&gt;Concurrent trigger for same source returns HTTP 409&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#B27B19;strokeWidth=1.5;fontColor=#3A2C13;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="420" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="statusNote" value="IMPLEMENTATION NOTE&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Current pipeline.py has syntax errors at the core/mart step markers, so the orchestrator cannot import it as written. Its code otherwise calls core and mart; this conflicts with the README statement that those stages are disabled on this branch.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FDE2E0;strokeColor=#C23B32;strokeWidth=1.5;fontColor=#561C18;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="400" width="710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="composeNote" value="Compose startup dependencies&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;staging + users healthy → core healthy → mart healthy; orchestrator waits for extractor, loader, core and mart.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#E8F1F3;strokeColor=#277C87;strokeWidth=1.5;fontColor=#12343B;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1990" y="415" width="630" height="105" as="geometry" />
        </mxCell>

