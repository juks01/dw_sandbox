  <diagram id="dw-dev-logic" name="DW logic">
    <mxGraphModel dx="2900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
