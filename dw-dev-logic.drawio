          <mxGeometry x="1430" y="625" width="1410" height="500" as="geometry" />
        </mxCell>
        <mxCell id="title" value="DW-DEV | DATA FLOW &amp; ORCHESTRATION" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#18212B;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subTitle" value="Source registration, scheduled/manual runs, validated landing files, staging load and downstream publishing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#52616B;" vertex="1" parent="1">
          <mxGeometry x="40" y="65" width="1400" height="25" as="geometry" />
        </mxCell>

        <mxCell id="user" value="Operator&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;GUI / REST&lt;br&gt;HTTP Basic Auth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="155" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="Scheduler&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;croniter; configured polling interval&lt;br&gt;10 s in .env-template; enabled sources&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=16;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="orchestrator" value="ORCHESTRATOR&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;FastAPI + runner&lt;br&gt;pre-flight dependency health&lt;br&gt;one active run per source&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF2;strokeColor=#277C87;strokeWidth=2;fontColor=#12343B;fontSize=17;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="190" width="240" height="145" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="Orchestrator SQLite&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;sources, cron / next_run / timezone&lt;br&gt;run status, step, error, batch&lt;br&gt;checkpoint and load mode&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF1D6;strokeColor=#B27B19;strokeWidth=1.5;fontColor=#3A2C13;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="315" y="410" width="230" height="125" as="geometry" />
        </mxCell>

        <mxCell id="extractor" value="EXTRACTOR&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;allowlist URL check&lt;br&gt;GET source; validate JSON&lt;br&gt;write payload + manifest atomically&lt;br&gt;manifest includes SHA-256&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF2E5;strokeColor=#42865A;strokeWidth=2;fontColor=#183D25;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="190" width="250" height="145" as="geometry" />
        </mxCell>
        <mxCell id="source" value="External HTTP JSON source&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;host must be allowlisted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="55" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="landing" value="LANDING&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;shared host-mounted directory&lt;br&gt;raw JSON + matching .manifest.json&lt;br&gt;payload remains unchanged&lt;/font&gt;" style="shape=folder;tabWidth=40;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#E8E5F5;strokeColor=#7665A8;strokeWidth=1.5;fontColor=#2F2850;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="205" width="220" height="125" as="geometry" />
        </mxCell>
        <mxCell id="loader" value="LOADER&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;check manifest + payload name&lt;br&gt;verify SHA-256; reject invalid files&lt;br&gt;flatten nested JSON&lt;br&gt;deduplicate filename / batch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE6D8;strokeColor=#BD7144;strokeWidth=2;fontColor=#4D2D1B;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1300" y="190" width="250" height="145" as="geometry" />
        </mxCell>
        <mxCell id="staging" value="STAGING (PostgreSQL)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;staging.raw_batches (raw payload)&lt;br&gt;dynamic source / child tables&lt;br&gt;row IDs, parent IDs, batch IDs&lt;br&gt;schema adapts to new columns&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FCE6D8;strokeColor=#BD7144;strokeWidth=2;fontColor=#4D2D1B;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1630" y="190" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="users" value="USERS (PostgreSQL)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;department + end_user&lt;br&gt;fixed reference data&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1645" y="420" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="core" value="CORE (PostgreSQL)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;sync_users() + exact-batch sync_from_staging()&lt;br&gt;dynamic dim_* tables; SCD2 versions&lt;br&gt;close absent keys only on complete full snapshot&lt;br&gt;RLS is scoped to core.dim_user&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E3EDF8;strokeColor=#4D79A8;strokeWidth=2;fontColor=#1D3550;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1980" y="190" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="mart" value="MART (PostgreSQL)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;mart.refresh() rebuilds tables&lt;br&gt;current rows only; excludes SCD columns&lt;br&gt;GRANT SELECT to reporting&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F8E4EB;strokeColor=#A84C69;strokeWidth=2;fontColor=#4B2330;fontSize=16;fontStyle=1;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2330" y="190" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="reporting" value="Reporting&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;read-only SELECT&lt;br&gt;mart.*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.5;fontColor=#18212B;fontSize=15;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="2670" y="215" width="170" height="100" as="geometry" />
        </mxCell>

        <mxCell id="runState" value="Run lifecycle&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;queued → health_check → extract → load → core → mart → done&lt;br&gt;Any failed step records status, step, error and finish time&lt;br&gt;Concurrent trigger for same source returns HTTP 409&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#B27B19;strokeWidth=1.5;fontColor=#3A2C13;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="420" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="statusNote" value="CURRENT IMPLEMENTATION LIMITS&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;All stages currently run on one Compose bridge network. Extractor and Loader share a host-mounted landing directory; it is not remote object storage. Core/Mart FDW hosts are hard-coded to Compose DNS names and port 5432; some Orchestrator DB ports are also fixed.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FDE2E0;strokeColor=#C23B32;strokeWidth=1.5;fontColor=#561C18;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="400" width="710" height="140" as="geometry" />
        </mxCell>
        <mxCell id="composeNote" value="Compose startup dependencies&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;staging + users healthy → core healthy → mart healthy; orchestrator waits for extractor, loader, core and mart.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#E8F1F3;strokeColor=#277C87;strokeWidth=1.5;fontColor=#12343B;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1990" y="415" width="630" height="105" as="geometry" />
        </mxCell>
        <mxCell id="envTitle" value="DEPLOYMENT ENVIRONMENTS &amp; CONNECTION CONTRACTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#18212B;" vertex="1" parent="1">
          <mxGeometry x="65" y="640" width="1400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="devEnvTitle" value="CURRENT: single-host Compose development" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#12343B;" vertex="1" parent="1">
          <mxGeometry x="70" y="680" width="650" height="30" as="geometry" />
        </mxCell>
        <mxCell id="devCompose" value="Compose network: dw&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Orchestrator + Extractor + Loader&lt;br&gt;Staging + Users + Core + Mart&lt;br&gt;service-name DNS; internal DB port 5432&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF2;strokeColor=#277C87;strokeWidth=1.5;fontColor=#12343B;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="75" y="730" width="400" height="125" as="geometry" />
        </mxCell>
        <mxCell id="devLanding" value="Local shared landing&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;./data/landing mounted into&lt;br&gt;both Extractor and Loader&lt;br&gt;JSON payload + manifest files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E5F5;strokeColor=#7665A8;strokeWidth=1.5;fontColor=#2F2850;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="730" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="devVolumes" value="Persistent local state&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;PostgreSQL named volumes&lt;br&gt;orchestrator/data SQLite bind mount&lt;br&gt;.env supplies development config&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1D6;strokeColor=#B27B19;strokeWidth=1.5;fontColor=#3A2C13;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="905" y="730" width="430" height="125" as="geometry" />
        </mxCell>
        <mxCell id="devConnections" value="Connections within this environment&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Orchestrator → Extractor / Loader: HTTP (POST /extract, POST /load); Extractor → Loader data handoff: shared files. Loader → Staging: PostgreSQL. Orchestrator → Staging / Core / Mart: PostgreSQL health and pipeline calls. Core → Staging + Users: postgres_fdw. Mart → Core: postgres_fdw. Reporting → Mart: read-only PostgreSQL.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FFFFFF;strokeColor=#667085;strokeWidth=1.2;fontColor=#18212B;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="75" y="880" width="1260" height="205" as="geometry" />
        </mxCell>
        <mxCell id="targetEnvTitle" value="TARGET: separable VM / physical-machine environments (not yet implemented)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#5C4210;" vertex="1" parent="1">
          <mxGeometry x="1460" y="680" width="930" height="30" as="geometry" />
        </mxCell>
        <mxCell id="targetSource" value="Source environment&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;External JSON APIs&lt;br&gt;outbound HTTPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#667085;strokeWidth=1.2;fontColor=#18212B;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1460" y="735" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="targetControl" value="Control environment&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Orchestrator + SQLite&lt;br&gt;GUI / API / scheduler&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF2;strokeColor=#277C87;strokeWidth=1.5;fontColor=#12343B;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1670" y="735" width="205" height="110" as="geometry" />
        </mxCell>
        <mxCell id="targetIngestion" value="Ingestion environment(s)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Extractor and Loader may be&lt;br&gt;separate services / machines&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF4EC;strokeColor=#42865A;strokeWidth=1.5;fontColor=#183D25;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1895" y="735" width="215" height="110" as="geometry" />
        </mxCell>
        <mxCell id="targetStorage" value="Landing storage boundary&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Replace shared local directory&lt;br&gt;with agreed object/shared storage&lt;br&gt;or authenticated file-transfer API&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E5F5;strokeColor=#7665A8;strokeWidth=1.5;fontColor=#2F2850;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2130" y="735" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="targetData" value="Data environments&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Staging / Users / Core / Mart&lt;br&gt;may be separate DB hosts&lt;br&gt;independent persistent storage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3EDF8;strokeColor=#4D79A8;strokeWidth=1.5;fontColor=#1D3550;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2380" y="735" width="225" height="110" as="geometry" />
        </mxCell>
        <mxCell id="targetReporting" value="Reporting environment&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Clients / BI tools&lt;br&gt;read-only Mart account&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8E4EB;strokeColor=#A84C69;strokeWidth=1.5;fontColor=#4B2330;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="2625" y="735" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="targetLinks" value="Required inter-environment links (configure endpoints, credentials and storage contract end to end)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Source → Extractor: outbound HTTPS. Orchestrator ↔ Extractor / Loader: HTTP API. Extractor → landing storage → Loader: payload + manifest transfer. Loader → Staging: PostgreSQL. Orchestrator → Staging / Core / Mart: PostgreSQL health, sync and refresh calls. Core → Staging + Users and Mart → Core: PostgreSQL FDW connections. Reporting → Mart: read-only PostgreSQL. Carry run ID, exact batch ID, manifest/checkpoint and pagination-complete metadata across the boundaries.&lt;br&gt;&lt;b&gt;Current gap:&lt;/b&gt; FDW hostnames/port and some app DB ports are hard-coded to Compose network values; the shared directory is local. Distributed links/storage need implementation before deployment across machines. Firewall rule details are intentionally out of scope.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fillColor=#FFFFFF;strokeColor=#B27B19;strokeWidth=1.2;fontColor=#3A2C13;fontSize=14;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="880" width="1355" height="205" as="geometry" />
        </mxCell>

        <mxCell id="eUserOrch" value="manual run / source CRUD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="user" target="orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eSchedOrch" value="due cron → trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475467;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="scheduler" target="orchestrator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOrchDb" value="read / update sources + runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=block;startFill=1;strokeColor=#B27B19;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="orchestrator" target="sqlite">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOrchExtract" value="POST /extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#277C87;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="orchestrator" target="extractor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eSourceExtractor" value="GET JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#42865A;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="source" target="extractor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eExtractLanding" value="payload + manifest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7665A8;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="extractor" target="landing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOrchLoader" value="POST /load (filename)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#277C87;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="orchestrator" target="loader">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="590" y="375" /><mxPoint x="1430" y="375" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eLandingLoader" value="read shared files" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#BD7144;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="landing" target="loader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eLoaderStaging" value="transactional batch + flattened rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#BD7144;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="loader" target="staging">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eStagingCore" value="FDW; sync_from_staging()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D79A8;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="staging" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eUsersCore" value="FDW; sync_users()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4D79A8;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eCoreMart" value="FDW; refresh current rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#A84C69;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="core" target="mart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eMartReport" value="SELECT only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#A84C69;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="mart" target="reporting">
          <mxGeometry relative="1" as="geometry" />
