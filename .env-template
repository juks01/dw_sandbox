# =============================================================================
# dw-dev environment configuration
# DEV ONLY. Never commit this file. See .gitignore.
# =============================================================================

# ---- Common admin credentials (dev: same everywhere) ----
ADMIN_USER=admin
ADMIN_PASSWORD=admin
POSTGRES_PASSWORD=devpassword

# ---- Per-database service accounts ----
# STAGING
LOADER_WRITER_USER=loader_writer
LOADER_WRITER_PASSWORD=loaderpass
STAGING_READER_USER=staging_reader
STAGING_READER_PASSWORD=stagingreaderpass

# USERS
USERS_READER_USER=users_reader
USERS_READER_PASSWORD=usersreaderpass

# CORE
CORE_READER_USER=core_reader
CORE_READER_PASSWORD=corereaderpass
CORE_SERVICE_USER=core_service
CORE_SERVICE_PASSWORD=coreservicepass

# MART
MART_READER_USER=mart_reader
MART_READER_PASSWORD=martreaderpass
MART_SERVICE_USER=mart_service
MART_SERVICE_PASSWORD=martservicepass
REPORTING_USER=reporting
REPORTING_PASSWORD=reportingpass

# --- - Database hosts (container network, service names as hostnames) ----
STAGING_HOST=staging
USERS_HOST=users
CORE_HOST=core
MART_HOST=mart

# ---- Ports published to host ----
ORCHESTRATOR_PORT=8080
STAGING_PORT=5433
CORE_PORT=5434
MART_PORT=5435
USERS_PORT=5436

# ---- Database names ----
STAGING_DB=staging
USERS_DB=users
CORE_DB=core
MART_DB=mart

# ---- Timezone / locale ----
TZ=Europe/Helsinki
PG_LOCALE=fi_FI.UTF-8

# ---- Orchestrator ----
ORCH_USER=admin
ORCH_PASSWORD=admin
ORCH_SQLITE_PATH=/data/orchestrator.db
ORCH_SCHEDULER_INTERVAL_SECONDS=5

# ---- Extractor ----
EXTRACTOR_USER_AGENT=dw-dev-extractor/1.0

# ---- Internal service URLs (container network, service names as hostnames) ----
EXTRACTOR_URL=http://extractor:8000
LOADER_URL=http://loader:8000
